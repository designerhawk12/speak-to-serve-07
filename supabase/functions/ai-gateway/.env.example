# Server-side Edge Function secrets/configuration only. Never prefix these with VITE_.
AI_PROVIDER=deterministic
# To enable the OpenAI provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=8000
AI_RETRY_LIMIT=1
AI_RATE_LIMIT_SALT=replace-with-a-long-random-server-secret
